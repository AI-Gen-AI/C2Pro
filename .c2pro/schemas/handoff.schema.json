{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "c2pro-handoff-v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "work_id", "role", "base_sha", "current_head", "current_worker", "handoff_reason", "completed", "remaining", "files_changed", "required_tests_remaining", "known_findings", "forbidden_scope_reminder", "next_worker"],
  "properties": {
    "schema": {"const": "c2pro-handoff-v1"},
    "work_id": {"type": "string", "pattern": "^C2P-[A-Z0-9-]+$", "maxLength": 128},
    "role": {"type": "string", "pattern": "^[a-z][a-z0-9_]{1,63}$"},
    "base_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "current_head": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "current_worker": {"type": "string", "minLength": 1, "maxLength": 128},
    "handoff_reason": {"enum": ["quota_exhausted", "provider_unavailable", "session_limit", "timeout", "worker_failure", "planned_reassignment"]},
    "completed": {"type": "array", "maxItems": 32, "items": {"type": "string", "minLength": 1, "maxLength": 500}},
    "remaining": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"type": "string", "minLength": 1, "maxLength": 500}},
    "files_changed": {"type": "array", "maxItems": 64, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 320}},
    "required_tests_remaining": {"type": "array", "maxItems": 32, "items": {"type": "string", "minLength": 1, "maxLength": 500}},
    "known_findings": {"type": "array", "maxItems": 32, "items": {"type": "string", "minLength": 1, "maxLength": 500}},
    "forbidden_scope_reminder": {"type": "array", "maxItems": 64, "items": {"type": "string", "minLength": 1, "maxLength": 320}},
    "next_worker": {"type": ["string", "null"], "maxLength": 128}
  }
}

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "c2pro-current-v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "state_version",
    "repository",
    "control_status",
    "active_campaign_id",
    "active_work_ids",
    "queue_ref",
    "context_budget_ref",
    "legacy_compatibility_ref",
    "authority",
    "history"
  ],
  "properties": {
    "schema": {
      "const": "c2pro-current-v1"
    },
    "state_version": {
      "const": 1
    },
    "repository": {
      "const": "AI-Gen-AI/C2Pro"
    },
    "control_status": {
      "enum": [
        "bootstrap_no_runtime_activation",
        "active",
        "paused"
      ]
    },
    "active_campaign_id": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 128
    },
    "active_work_ids": {
      "type": "array",
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^C2P-[A-Z0-9-]+$",
        "maxLength": 128
      }
    },
    "queue_ref": {
      "const": ".c2pro/control/work-queue.yaml"
    },
    "context_budget_ref": {
      "const": ".c2pro/control/context-budget.yaml"
    },
    "legacy_compatibility_ref": {
      "const": ".c2pro/control/legacy-compatibility.yaml"
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "parent_plan",
        "execution_boundary",
        "route_authority"
      ],
      "properties": {
        "parent_plan": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "execution_boundary": {
          "const": "AI-Gen AF-DEV-01"
        },
        "route_authority": {
          "const": "AI-Gen MR-DEV-01"
        }
      }
    },
    "history": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "primary_source",
        "completed_work_retained_in_hot_state"
      ],
      "properties": {
        "primary_source": {
          "const": "git_pr_ci"
        },
        "completed_work_retained_in_hot_state": {
          "const": false
        }
      }
    }
  }
}

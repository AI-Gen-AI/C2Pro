{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "c2pro-work-envelope-v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "work_id",
    "campaign_id",
    "role",
    "status",
    "risk_class",
    "base_sha",
    "branch",
    "scope",
    "out_of_scope",
    "allowed_tools",
    "forbidden_paths",
    "acceptance_criteria",
    "required_tests",
    "evidence_required",
    "review_policy",
    "worker_selection",
    "timeout_resource_policy"
  ],
  "properties": {
    "schema": {"const": "c2pro-work-envelope-v1"},
    "work_id": {"type": "string", "pattern": "^C2P-[A-Z0-9-]+$", "maxLength": 128},
    "campaign_id": {"type": ["string", "null"], "maxLength": 128},
    "role": {"type": "string", "pattern": "^[a-z][a-z0-9_]{1,63}$"},
    "status": {"enum": ["queued", "in_progress", "blocked", "review", "ready_for_pr"]},
    "risk_class": {"enum": ["trivial", "normal", "material", "high"]},
    "base_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "branch": {"type": "string", "minLength": 1, "maxLength": 200},
    "scope": {"type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 320}},
    "out_of_scope": {"type": "array", "maxItems": 64, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 320}},
    "allowed_tools": {"type": "array", "maxItems": 32, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 128}},
    "forbidden_paths": {"type": "array", "maxItems": 64, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 320}},
    "acceptance_criteria": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"type": "string", "minLength": 1, "maxLength": 500}},
    "required_tests": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"type": "string", "minLength": 1, "maxLength": 500}},
    "evidence_required": {"type": "array", "maxItems": 32, "items": {"type": "string", "minLength": 1, "maxLength": 256}},
    "review_policy": {"enum": ["none_by_policy", "independent_principal", "principal_plus_challenger"]},
    "worker_selection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["preferred", "fallback"],
      "properties": {
        "preferred": {"type": ["string", "null"], "maxLength": 128},
        "fallback": {"type": "array", "maxItems": 8, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 128}}
      }
    },
    "timeout_resource_policy": {"type": "string", "minLength": 1, "maxLength": 256},
    "dependencies": {"type": "array", "maxItems": 32, "uniqueItems": true, "items": {"type": "string", "pattern": "^C2P-[A-Z0-9-]+$", "maxLength": 128}},
    "architecture_refs": {"type": "array", "maxItems": 32, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 320}}
  }
}

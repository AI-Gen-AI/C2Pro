{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "c2pro-context-budget-v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "budget_version", "units", "limits", "default_hot_files", "rules"],
  "properties": {
    "schema": {"const": "c2pro-context-budget-v1"},
    "budget_version": {"const": 1},
    "units": {"const": "bytes_utf8"},
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bootstrap_hot_state_max", "single_work_envelope_max", "single_handoff_max", "single_evidence_reference_max", "default_work_packet_max"],
      "properties": {
        "bootstrap_hot_state_max": {"type": "integer", "minimum": 1024, "maximum": 65536},
        "single_work_envelope_max": {"type": "integer", "minimum": 1024, "maximum": 65536},
        "single_handoff_max": {"type": "integer", "minimum": 1024, "maximum": 65536},
        "single_evidence_reference_max": {"type": "integer", "minimum": 1024, "maximum": 65536},
        "default_work_packet_max": {"type": "integer", "minimum": 4096, "maximum": 131072}
      }
    },
    "default_hot_files": {"type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 320}},
    "rules": {"type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 256}}
  }
}

{
  "name": "c2pro-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "node ./scripts/clean-next-build.mjs && next build --webpack",
    "typecheck": "tsc --noEmit",
    "generate:api": "orval",
    "generate:api:check": "orval && pnpm exec prettier --write lib/api/generated schema/api.json && git diff --exit-code -- lib/api/generated schema/api.json",
    "start": "next start",
    "lint": "eslint .",
    "test": "node ./scripts/vitest-no-warn.mjs run src/tests/integration --config vitest.integration.config.ts",
    "test:nowarn": "node ./scripts/vitest-no-warn.mjs",
    "test:all": "node ./scripts/vitest-run-all.mjs",
    "test:watch": "vitest --configLoader native",
    "test:coverage": "node ./scripts/vitest-no-warn.mjs run --coverage",
    "test:e2e": "playwright test",
    "test:visual": "playwright test --project=visual-regression src/tests/e2e/core-pages.visual.spec.ts",
    "verify:openspec": "npm --prefix ../.. run verify:openspec --"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.4.0",
    "@dnd-kit/core": "^6.1.0",
    "@dnd-kit/sortable": "^8.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/source-serif-4": "^5.2.9",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toast": "^1.2.15",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@sentry/react": "^10.38.0",
    "@tanstack/react-query": "^5.87.1",
    "axios": "^1.18.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^3.6.0",
    "geist": "^1.7.2",
    "lucide-react": "^0.562.0",
    "next": "16.2.10",
    "next-themes": "^0.4.6",
    "pdfjs-dist": "^5.4.530",
    "react": "19.1.5",
    "react-dom": "19.1.5",
    "react-pdf": "^10.3.0",
    "react-resizable-panels": "^2.1.9",
    "recharts": "^2.15.4",
    "sonner": "^1.7.4",
    "tailwind-merge": "^3.4.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.4.3",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@clerk/testing": "^2.0.29",
    "@playwright/test": "^1.51.1",
    "@tailwindcss/postcss": "^4.1.18",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20.19.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^4.1.2",
    "eslint": "9.35.0",
    "eslint-config-next": "16.2.1",
    "jsdom": "^29.0.1",
    "msw": "^2.7.0",
    "openapi-typescript-codegen": "^0.29.0",
    "orval": "^8.18.0",
    "postcss": "^8.5.17",
    "tailwindcss": "^4.1.18",
    "typescript": "5.3.3",
    "typescript-eslint": "^8.55.0",
    "vite": "7.3.5",
    "vitest": "^4.1.2"
  },
  "overrides": {
    "brace-expansion": "5.0.5",
    "esbuild": "0.27.4",
    "flatted": "3.4.2",
    "handlebars": "4.7.9",
    "minimatch": "10.2.4",
    "picomatch": "4.0.4",
    "rollup": "4.60.0",
    "yaml": "2.8.3"
  }
}

# ===========================================
# C2Pro API - Docker Build Ignore
# ===========================================

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
.venv*/
ENV/

# Testing
tests/
.pytest_cache/
.coverage
htmlcov/
*.xml
coverage.xml

# IDE
.vscode/
.idea/
*.swp
*.swo

# Git
.git/
.gitignore

# Docker
Dockerfile
docker-compose*.yml
.dockerignore

# Documentation
*.md
docs/

# Development
.env
.env.*
Makefile
*.log

# Build artifacts
build/
dist/
*.egg-info/

# Alembic (keep migrations, exclude cache)
alembic/__pycache__/
alembic/versions/__pycache__/

# Misc
*.bak
*.tmp
.DS_Store

# Local/private credentials must never enter the Docker build context
credentials.json
*credentials*.json
*service-account*.json
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer

# Production runtime source allowlist hygiene
src/core/ai/test_*.py
src/core/ai/example_*.py
src/golden/
src/projects/adapters/http/router.py.fullversion

# Non-runtime top-level development/test tooling
dev.py
evals/
examples/
install_spacy_model.py
migrate.py
migrations/
mypy-baseline.txt
requirements-sprint1.txt
setup.py
test*.py

# Only the production runtime scripts belong in the image
scripts/*
!scripts/run_api.sh
!scripts/run_worker.sh
!scripts/run_scheduler.sh
!scripts/wait_for_schema.py

%% Current authority: docs/architecture/C2PRO_TECHNICAL_DESIGN_DOCUMENT_v4_2.md + Accepted ADRs.

%%{init: {
  'theme': 'base',
  'themeVariables': {
    'primaryColor': '#1a1a2e',
    'primaryTextColor': '#eaeaea',
    'primaryBorderColor': '#16213e',
    'lineColor': '#0f3460',
    'secondaryColor': '#0f3460',
    'tertiaryColor': '#e94560',
    'background': '#0f0f23',
    'mainBkg': '#1a1a2e',
    'nodeBorder': '#e94560',
    'clusterBkg': '#16213e',
    'clusterBorder': '#0f3460',

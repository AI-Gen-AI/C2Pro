{
  "name": "c2pro-monorepo",
  "private": true,
  "version": "1.0.0",
  "description": "> Sistema de auditoría tridimensional (Contrato + Cronograma + Presupuesto) con IA para detectar incoherencias antes de que generen sobrecostes.",
  "homepage": "https://github.com/AI-Gen-AI/C2Pro#readme",

  },
  "license": "ISC",
  "author": "AI-Gen",
  "packageManager": "pnpm@10.25.0",
  "engines": {
    "node": ">=22 <23",
    "pnpm": ">=10"
  },
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "preinstall": "npx -y only-allow pnpm",
    "test": "echo \"Error: no test specified\" && exit 1",
    "prepare": "husky",
    "lint": "eslint .",
    "format": "prettier --write .",
    "verify:openspec": "python scripts/verify_openspec_change.py"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.0.0",
    "globals": "^17.7.0",
    "husky": "^9.1.7",
    "prettier": "^3.9.5",
    "supabase": "^2.109.1",
    "vitest": "^4.1.10"
  },
  "pnpm": {
    "overrides": {
      "axios": "1.18.1",
      "ajv": "8.18.0",
      "eslint>ajv": "6.12.6",
      "@eslint/eslintrc>ajv": "6.12.6",
      "brace-expansion": "5.0.9",
      "fast-uri": "3.1.5",
      "flatted": "3.4.2",
      "handlebars": "4.7.9",
      "js-cookie": "3.0.7",
      "js-yaml": "4.3.1",
      "minimatch": "10.2.4",
      "pdfjs-dist": "5.4.296",
      "picomatch": "4.0.4",
      "postcss": "8.5.23",
      "rollup": "4.60.0",
      "sharp": "0.35.0",
      "undici": "7.29.0",
      "yaml": "2.8.3"

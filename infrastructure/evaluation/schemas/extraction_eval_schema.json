{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ExtractionEvalDataset",
  "description": "Schema for Document Extraction (I3) evaluation datasets",
  "type": "object",
  "required": ["dataset_name", "version", "service", "examples"],
  "properties": {
    "dataset_name": {
      "type": "string",
      "pattern": "^c2pro_extraction_eval.*$"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "created_at": {
      "type": "string",
      "format": "date"
    },
    "service": {
      "const": "document_extraction_i3"
    },
    "metadata": {
      "type": "object",
      "properties": {
        "model_version": {"type": "string"},
        "extraction_config": {"type": "string"}
      }
    },
    "baseline_metrics": {
      "type": "object",
      "properties": {
        "entity_f1": {"type": "number", "minimum": 0, "maximum": 1},
        "boundary_iou": {"type": "number", "minimum": 0, "maximum": 1},
        "actor_accuracy": {"type": "number", "minimum": 0, "maximum": 1},
        "date_extraction_accuracy": {"type": "number", "minimum": 0, "maximum": 1},
        "amount_extraction_accuracy": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "examples": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "input", "expected_output"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^EX-EVAL-\\d{4}$"
          },
          "category": {
            "enum": ["clause_boundary", "entity_extraction", "obligation_parsing", "mixed", "malformed"]
          },
          "input": {
            "type": "object",
            "required": ["document_text"],
            "properties": {
              "document_text": {"type": "string", "minLength": 50},
              "document_type": {
                "enum": ["contract", "addendum", "specification", "proposal", "tender"]
              },
              "page_range": {
                "type": "array",
                "items": {"type": "integer"}
              },
              "language": {
                "enum": ["es", "en"]
              }
            }
          },
          "expected_output": {
            "type": "object",
            "required": ["clauses"],
            "properties": {
              "clauses": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["text", "type"],
                  "properties": {
                    "clause_id": {"type": "string"},
                    "text": {"type": "string"},
                    "type": {"type": "string"},
                    "start_char": {"type": "integer"},
                    "end_char": {"type": "integer"},
                    "modality": {
                      "enum": ["shall", "may", "must_not", "will", "should", "none"]
                    },
                    "actors": {
                      "type": "array",
                      "items": {"type": "string"}
                    },
                    "due_date": {
                      "type": ["string", "null"],
                      "format": "date"
                    },
                    "amounts": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "value": {"type": "number"},
                          "currency": {"type": "string"},
                          "type": {"type": "string"}
                        }
                      }
                    },
                    "ambiguity_flag": {"type": "boolean"},
                    "confidence_range": {
                      "type": "array",
                      "items": {"type": "number"},
                      "minItems": 2,
                      "maxItems": 2
                    }
                  }
                }
              },
              "total_clause_count": {"type": "integer", "minimum": 0},
              "high_impact_clauses": {
                "type": "array",
                "items": {"type": "string"}
              },
              "entities": {
                "type": "object",
                "properties": {
                  "actors": {"type": "array", "items": {"type": "string"}},
                  "dates": {"type": "array", "items": {"type": "string"}},
                  "amounts": {"type": "array", "items": {"type": "object"}}
                }
              }
            }
          },
          "extraction_difficulty": {
            "enum": ["standard", "nested", "implicit", "malformed"]
          },
          "human_rationale": {"type": "string"}
        }
      }
    }
  }
}

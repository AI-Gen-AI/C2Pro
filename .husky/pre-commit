#!/usr/bin/env sh
echo "🔍 Running Quality Gates (pre-commit)..."

# Backend lint (ruff) — only run against staged API Python files
if git diff --cached --name-only --diff-filter=ACMR | grep -qE '^apps/api/.*\.py$'; then
  echo "📝 Checking Python style (ruff)..."
  (
    cd apps/api || exit 1
    git diff --cached --name-only --diff-filter=ACMR |
      grep -E '^apps/api/.*\.py$' |
      sed 's#^apps/api/##' |
      while IFS= read -r file; do
        python -m ruff check "$file" || exit 1
      done
  ) || { echo "❌ Ruff failed!"; exit 1; }
fi

# Frontend lint (ESLint) — only run when JS/TS/TSX files are staged
if git diff --cached --name-only | grep -qE '\.(tsx?|jsx?|mjs|cjs)$'; then
  echo "📝 Checking frontend style (ESLint)..."
  pnpm --filter c2pro-web run lint || { echo "❌ ESLint failed!"; exit 1; }
fi

echo "✅ Pre-commit gates passed!"
